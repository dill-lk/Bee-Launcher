{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bee Launcher",
  "version": "0.1.40",
  "identifier": "com.blockline.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bee Launcher — Minecraft Java launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "Bee Launcher",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/bee-installer-header.bmp",
        "uninstallerHeaderImage": "windows/bee-installer-header.bmp",
        "sidebarImage": "windows/bee-installer-sidebar-v2.bmp",
        "installerHooks": "packaging/bee-nsis-hooks.nsh"
      }
    }
  }
}
